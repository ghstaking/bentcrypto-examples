{
  "name": "bentcrypto-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.ghstaking/bentcrypto-mcp",
  "type": "module",
  "description": "Local MCP bridge for BentCrypto x402 Token Risk on Solana and Base plus Token Security on Solana",
  "license": "MIT",
  "author": "BentCrypto",
  "homepage": "https://bentcrypto.com/agent-api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghstaking/bentcrypto-examples.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/ghstaking/bentcrypto-examples/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "crypto",
    "token-risk",
    "solana",
    "base",
    "ai-agents"
  ],
  "engines": { "node": ">=20" },
  "bin": { "bentcrypto-mcp": "./server.mjs" },
  "files": [
    "server.mjs",
    "lib.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node server.mjs",
    "check": "node --check server.mjs && node --check lib.mjs",
    "test": "node --test tests/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@scure/base": "2.0.0",
    "@solana/kit": "5.2.0",
    "@x402/core": "2.23.0",
    "@x402/evm": "2.23.0",
    "@x402/fetch": "2.23.0",
    "@x402/svm": "2.23.0",
    "viem": "2.56.0",
    "zod": "3.25.76"
  }
}
